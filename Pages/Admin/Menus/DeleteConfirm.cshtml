@page "{id:int}"
@model Admin.Menus.DeleteConfirmModel
@{
    ViewData["Title"] = "Eliminar Menú";
}

<a asp-page="../Menus/List" class="btn btn-sm btn-outline-secondary mb-3">&larr; Volver al Historial</a>
<h2 class="text-danger">🗑️ Eliminar Menú</h2>

<div class="alert alert-warning">
    <strong>&iquest;Estás seguro?</strong> Este menú será eliminado permanentemente y no podrá recuperarse.
</div>

<dl class="row">
    <dt class="col-sm-3">Semana del</dt>
    <dd class="col-sm-9">@Model.Menu?.SemanaFecha.ToShortDateString()</dd>

    <dt class="col-sm-3">Generado</dt>
    <dd class="col-sm-9">@Model.Menu?.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-3">Días</dt>
    <dd class="col-sm-9">@Model.Menu?.Dias.Count ?? 0</dd>
</dl>

<form method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger btn-lg">🗑 Sí, Eliminar Permanentemente</button>
    <a asp-page="../Menus/List" class="btn btn-secondary btn-lg">Cancelar</a>
</form>
