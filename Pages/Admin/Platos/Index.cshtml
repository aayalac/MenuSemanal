@page
@model Admin.Platos.IndexModel
@{
    ViewData["Title"] = "Catálogo de Platos";
}

<a asp-page="/Admin/Index" class="btn btn-sm btn-outline-secondary mb-3">&larr; Volver al Admin</a>
<h2>🍳 Catálogo de Platos</h2>
<p class="text-muted">Administra los platos disponibles para cada tipo de comida.</p>

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-auto">
        <label for="filtro" class="form-label visually-hidden">Filtrar:</label>
        <select id="filtro" name="categoria" class="form-select" onchange="this.form.submit()">
            <option value="">Todos</option>
            <option value="Desayuno" selected="@(Model.Filtro == "")">Desayunos (@Model.Estads.Desayuno)</option>
            <option value="Almuerzo" selected="@(Model.Filtro == "Almuerzo")">Almuerzos (@Model.Estads.Almuerzo)</option>
            <option value="Cena" selected="@(Model.Filtro == "Cena")">Cenas (@Model.Estads.Cena)</option>
        </select>
    </div>
    <div class="col-auto">
        <a asp-page="./Create" class="btn btn-primary">➕ Nuevo Plato</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>#</th>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var plato in Model.Platoss)
        {
            <tr>
                <td>@plato.Id</td>
                <td><strong>@Html.DisplayFor(_ => plato.Nombre)</strong></td>
                <td>
                    <span class="badge @(plato.Categoria.ToString() switch
                        { "Desayuno" => "bg-primary",
                          "Almuerzo" => "bg-warning text-dark",
                          "Cena" => "bg-danger",
                          _ => "bg-secondary" })">
                        @plato.Categoria
                    </span>
                </td>
                <td>
                    @if (plato.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-page="./Edit" asp-route-id="@plato.Id" class="btn btn-sm btn-outline-primary">✏️ Editar</a>
                    <a asp-page="./Delete" asp-route-id="@plato.Id" class="btn btn-sm btn-outline-danger">🗑️ Eliminar</a>
                </td>
            </tr>
        }
        @if (!Model.Platoss.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted py-4">No se encontraron platos.</td>
            </tr>
        }
    </tbody>
</table>
