@page
@model Admin.Platos.IndexModel
@{
    ViewData["Title"] = "Catálogo de Platos";
}

<h2 class="mb-2">🍳 Catálogo de Platos</h2>
<partial name="_AdminNav" />
<p class="text-muted">Administra los platos disponibles. Un plato puede pertenecer a varias franjas.</p>

@if (TempData["SuccessMsg"] is string msg)
{
    <div class="alert alert-success" role="alert">@msg</div>
}

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-auto">
        <label for="filtro" class="form-label visually-hidden">Filtrar:</label>
        <select id="filtro" name="categoria" class="form-select" onchange="this.form.submit()">
            <option value="">Todos (@Model.Total)</option>
            <option value="Desayuno" selected="@(Model.Filtro == "Desayuno")">Desayunos (@Model.Estadisticas.Desayuno)</option>
            <option value="Almuerzo" selected="@(Model.Filtro == "Almuerzo")">Almuerzos (@Model.Estadisticas.Almuerzo)</option>
            <option value="Cena" selected="@(Model.Filtro == "Cena")">Cenas (@Model.Estadisticas.Cena)</option>
        </select>
    </div>
    <div class="col-auto">
        <a asp-page="./Create" class="btn btn-primary">➕ Nuevo Plato</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>#</th>
            <th>Nombre</th>
            <th>Franjas</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var plato in Model.Platos)
        {
            <tr>
                <td>@plato.Id</td>
                <td><strong>@Html.DisplayFor(_ => plato.Nombre)</strong></td>
                <td><partial name="_FranjaBadges" model="plato.Franjas" /></td>
                <td>
                    @if (plato.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-page="./Edit" asp-route-id="@plato.Id" class="btn btn-sm btn-outline-primary">✏️ Editar</a>
                    <a asp-page="./Delete" asp-route-id="@plato.Id" class="btn btn-sm btn-outline-danger">🗑️ Eliminar</a>
                </td>
            </tr>
        }
        @if (!Model.Platos.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted py-4">No se encontraron platos.</td>
            </tr>
        }
    </tbody>
</table>
