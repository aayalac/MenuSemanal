@page "{id:int}"
@model Admin.Platos.EditModel
@{
    ViewData["Title"] = "Editar Plato";
}

<a asp-page="/Admin/Platos/Index" class="btn btn-sm btn-outline-secondary mb-3">&larr; Volver al Catálogo</a>
<h2>✏️ @((Model.Plato != null) ? "Editar Plato" : "Plato No Encontrado")</h2>

@if (Model.Message != null)
{
    <div class="alert alert-@(Model.Success ? "success" : "danger")" role="alert">@Model.Message</div>
}

@if (Model.Plato != null)
{
    <form method="post" class="mt-3" style="max-width: 500px;">
        <div class="mb-3">
            <label asp-for="Plato.Id" class="form-label d-none"></label>
            <input asp-for="Plato.Id" type="hidden" />
        </div>
        <div class="mb-3">
            <label asp-for="Plato.Nombre" class="form-label">Nombre del Plato</label>
            <input asp-for="Plato.Nombre" class="form-control" placeholder="Ej: Pollo a la naranja" autofocus />
            <span asp-validation-for="Plato.Nombre" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Plato.Categoria" class="form-label">Categoría</label>
            <select asp-for="Plato.Categoria" class="form-select">
                <option value="Desayuno">🥞 Desayuno</option>
                <option value="Almuerzo">🍲 Almuerzo</option>
                <option value="Cena">🌙 Cena</option>
            </select>
            <span asp-validation-for="Plato.Categoria" class="text-danger"></span>
        </div>
        <div class="mb-3 form-check">
            <input asp-for="Plato.Activo" class="form-check-input" />
            <label asp-for="Plato.Activo" class="form-check-label">Activo</label>
        </div>
        <button type="submit" class="btn btn-success">💾 Guardar Cambios</button>
    </form>
}
